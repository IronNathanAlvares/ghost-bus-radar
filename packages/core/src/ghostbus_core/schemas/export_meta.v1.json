{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ghostbus.meta.v1",
  "description": "Read first: freshness, which days are published, the archive chain head, the file list.",
  "type": "object",
  "required": [
    "schema",
    "attribution",
    "generated_at",
    "to",
    "latest_published_day",
    "days",
    "params_version",
    "files"
  ],
  "properties": {
    "schema": {
      "const": "ghostbus.meta.v1"
    },
    "attribution": {
      "$ref": "#/$defs/attribution"
    },
    "generated_at": {
      "type": "string"
    },
    "to": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "latest_published_day": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        }
      ]
    },
    "days": {
      "type": "array"
    },
    "params_version": {
      "type": "string"
    },
    "archive_chain_head": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      ]
    },
    "files": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "$defs": {
    "rate": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "k",
            "n",
            "rate",
            "lo",
            "hi"
          ],
          "properties": {
            "k": {
              "type": "integer",
              "minimum": 0
            },
            "n": {
              "type": "integer",
              "minimum": 1
            },
            "rate": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "lo": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "hi": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          }
        }
      ]
    },
    "attribution": {
      "type": "object",
      "required": [
        "source",
        "source_url",
        "licence",
        "disclaimer"
      ],
      "properties": {
        "source": {
          "type": "string"
        },
        "source_url": {
          "type": "string"
        },
        "licence": {
          "const": "CC BY 4.0"
        },
        "disclaimer": {
          "type": "string"
        }
      }
    }
  }
}
