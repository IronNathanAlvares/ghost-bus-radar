{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ghostbus.route.v1",
  "description": "One route: totals, a daily series and an hour-by-day-type heatmap, published days only.",
  "type": "object",
  "required": [
    "schema",
    "attribution",
    "agency",
    "route",
    "slug",
    "to",
    "total",
    "daily",
    "by_hour"
  ],
  "properties": {
    "schema": {
      "const": "ghostbus.route.v1"
    },
    "attribution": {
      "$ref": "#/$defs/attribution"
    },
    "agency": {
      "type": "string"
    },
    "route": {
      "type": "string"
    },
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$"
    },
    "to": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "total": {
      "type": "object"
    },
    "daily": {
      "type": "array"
    },
    "by_hour": {
      "type": "array"
    }
  },
  "$defs": {
    "rate": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "k",
            "n",
            "rate",
            "lo",
            "hi"
          ],
          "properties": {
            "k": {
              "type": "integer",
              "minimum": 0
            },
            "n": {
              "type": "integer",
              "minimum": 1
            },
            "rate": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "lo": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "hi": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          }
        }
      ]
    },
    "attribution": {
      "type": "object",
      "required": [
        "source",
        "source_url",
        "licence",
        "disclaimer"
      ],
      "properties": {
        "source": {
          "type": "string"
        },
        "source_url": {
          "type": "string"
        },
        "licence": {
          "const": "CC BY 4.0"
        },
        "disclaimer": {
          "type": "string"
        }
      }
    }
  }
}
