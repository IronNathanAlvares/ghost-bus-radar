{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ghostbus.stops.v1",
  "description": "Stop lookup: plate code, name, position and the routes serving it (current timetable).",
  "type": "object",
  "required": [
    "schema",
    "attribution",
    "stops"
  ],
  "properties": {
    "schema": {
      "const": "ghostbus.stops.v1"
    },
    "attribution": {
      "$ref": "#/$defs/attribution"
    },
    "stops": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "code",
          "name",
          "lat",
          "lon",
          "routes"
        ],
        "properties": {
          "code": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "lat": {
            "type": "number",
            "minimum": 51,
            "maximum": 56
          },
          "lon": {
            "type": "number",
            "minimum": -11,
            "maximum": -5
          },
          "routes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    }
  },
  "$defs": {
    "rate": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "k",
            "n",
            "rate",
            "lo",
            "hi"
          ],
          "properties": {
            "k": {
              "type": "integer",
              "minimum": 0
            },
            "n": {
              "type": "integer",
              "minimum": 1
            },
            "rate": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "lo": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "hi": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          }
        }
      ]
    },
    "attribution": {
      "type": "object",
      "required": [
        "source",
        "source_url",
        "licence",
        "disclaimer"
      ],
      "properties": {
        "source": {
          "type": "string"
        },
        "source_url": {
          "type": "string"
        },
        "licence": {
          "const": "CC BY 4.0"
        },
        "disclaimer": {
          "type": "string"
        }
      }
    }
  }
}
